{
  "tasks": {
    "main": "deno run --allow-read --allow-write src/main.ts",
    "dev": "deno run --inspect --watch src/main.ts",
    "test": "deno test"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/testing": "jsr:@std/testing@^1.0.7"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom"
    ],
    "strict": true
  },
  "fmt": {
    "proseWrap": "preserve",
    "lineWidth": 100000,
    "include": [
      "./src"
    ],
    "exclude": [
      "./src/todo.ts",
      "./src/parser/parserFunctionsNew.ts"
    ]
  },
  "lint": {
    "rules": {
      "include": [
        "eqeqeq",
        "no-external-import",
        "no-self-compare",
        "no-sparse-arrays",
        "no-throw-literal",
        "no-top-level-await"
      ],
      "exclude": []
    }
  },
  "test": {}
}